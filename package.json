{
  "name": "velocity",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "build": "bun run --cwd client build",
    "install:all": "bun install && bun install --cwd client && bun install --cwd server",
    "landing": "cd client && bun --bun vite ../landing --port 4173 --strictPort --host",
    "test:landing": "cd client && bunx playwright test -c playwright.landing.config.ts",
    "perf:landing": "cd client && bun e2e-landing/perf.mjs",
    "bench:runtime": "node scripts/bench-runtime.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "type": "module"
}
