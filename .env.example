PORT=3000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Plugins: let connectors (e.g. Blog Reader) fetch private/localhost hosts. Default off (SSRF guard).
# PLUGIN_FETCH_ALLOW_PRIVATE=on

# Build-time runtime switch (client). VITE_APP_ENV=production builds the browser-only version
# (no server; notes live in localStorage) used by the Vercel deploy. Leave unset for the
# self-hosted client–server build, including Docker.
# VITE_APP_ENV=production
