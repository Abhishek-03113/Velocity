PORT=3000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Plugins: let connectors (e.g. Blog Reader) fetch private/localhost hosts. Default off (SSRF guard).
# PLUGIN_FETCH_ALLOW_PRIVATE=on

# Herdr connector: share notes with coding agents running in herdr (https://herdr.dev).
# Off until a token is set; paste the same token in Settings → Plugins → Herdr.
# HERDR_CONNECTOR_TOKEN=change-me
# Socket: defaults to ~/.config/herdr/herdr.sock. In Docker on Linux, mount ~/.config/herdr read-only
# and point at it, e.g. HERDR_SOCKET_PATH=/run/herdr/herdr.sock
# HERDR_SOCKET_PATH=
# HERDR_SESSION=
# Attachments when Velocity can't write to the agent's folder (Docker):
# HERDR_ATTACHMENTS_DIR=/data/herdr-attachments
# HERDR_ATTACHMENTS_HOST_DIR=/home/you/velocity/herdr-attachments

# LaTeX plugin: compiles with a TeX engine installed on the server (TeX Live, MiKTeX or Tectonic).
# Engines are looked up on PATH (and LATEX_BIN_DIR first): latexmk, pdflatex, xelatex, lualatex, tectonic.
# Docker: LATEX=on docker compose build server installs a TeX Live subset in the server image.
# LATEX_COMPILE=off
# LATEX_ENGINE=pdflatex
# LATEX_BIN_DIR=
# LATEX_TIMEOUT_MS=30000
# LATEX_MAX_PDF_BYTES=20971520
# LATEX_MAX_CONCURRENT=2
