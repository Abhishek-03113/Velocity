FROM oven/bun:1.4-alpine

# SQLite comes from Bun's built-in `bun:sqlite`, so no native addon build tools are needed.

# LaTeX plugin: optional TeX engine for PDF compiles (adds a few hundred MB).
# LATEX=on docker compose build server   (or: docker build --build-arg LATEX=on …)
ARG LATEX=off
RUN if [ "$LATEX" = "on" ]; then apk add --no-cache texlive texmf-dist-latexrecommended texmf-dist-latexextra texmf-dist-fontsrecommended; fi

WORKDIR /app

# 1. Copy only the manifest and lockfile and install production deps
COPY server/package.json server/bun.lock ./
RUN bun install --frozen-lockfile --production

# 2. Copy application source (node_modules excluded by .dockerignore)
COPY server/ ./

# 3. Set the database path for Docker volume mount
ENV DB_PATH=/app/data/velocity.db

EXPOSE 3000
CMD ["bun", "index.ts"]
